              "raw": "{\n  \"titulo\": \"Ficciones\",\n  \"isbn\": \"978-0307950925\",\n  \"resumen\": \"Colección de cuentos que exploran temas de laberintos, espejos y el infinito.\",\n  \"anioPublicacion\": 1944,\n  \"editorial\": \"Sur\",\n  \"disponible\": true,\n  \"autorId\": 3,\n  \"categoriaId\": 1\n}"
